# Copy this file to .env and fill in your key. Never commit .env.

# --- LLM provider (Groq) ---
GROQ_API_KEY=
# The demos and fixes were measured on gpt-oss-120b. openai/gpt-oss-20b is a drop-in fallback with its own
# free-tier daily quota (200K tokens per day each); expect lower quality. Restart the server after changing it.
GROQ_MODEL=openai/gpt-oss-120b
# Reasoning tokens count toward the completion cap; "low" keeps them small.
GROQ_REASONING_EFFORT=low
# Real calls take about 5-15 s; this is also the time kept free at the end of a request.
LLM_CALL_TIMEOUT_S=30
LLM_SCHEMA_RETRIES=2
LLM_MAX_RATE_LIMIT_WAITS=3
# Used only if a 429 response carries no retry-after header.
LLM_RATE_LIMIT_FALLBACK_WAIT_S=10

# --- Token budget (Groq free tier: 8K tokens per minute) ---
# A hard maximum per request, not expected usage.
REQUEST_TOKEN_CEILING=40000
PER_CALL_TOKEN_CAP=6500
PACER_WINDOW_TOKENS=7500
PACER_WINDOW_S=60
COMPLETION_TOKENS_TASK=2000
COMPLETION_TOKENS_ANALYZE=2500

# --- Token estimator ---
ESTIMATE_CHARS_PER_TOKEN=3
ESTIMATE_TOKENS_PER_MESSAGE=10
ESTIMATE_MARGIN=0.2

# --- Request limits ---
# The free tier allows about two section calls per minute, so a 6-section document needs several minutes.
REQUEST_DEADLINE_S=480
MAX_REQUEST_CHARS=6000
MIN_PLAN_TASKS=2
# Related requested items are grouped into one section to stay within this limit.
MAX_PLAN_TASKS=6
MAX_REPAIR_SECTIONS=3

# --- Paths and logging ---
OUTPUT_DIR=outputs
LOG_LEVEL=INFO
